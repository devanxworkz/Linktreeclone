# Pehchaan web — sample environment. Copy to web/.env.local for local overrides.
#
# Local dev: the Vite proxy forwards /api to the API server, so leave this unset.
# VITE_API_BASE_URL=http://localhost:4000
#
# Vercel (frontend on a different domain from the API):
# Set VITE_API_BASE_URL to the public API origin, e.g.
# VITE_API_BASE_URL=https://linktreeclone-ynml.onrender.com
# Alternatively leave it unset and let web/vercel.json proxy /api to the API host,
# which keeps requests same-origin (recommended if the proxy rewrite is deployed).
